# Translation backend: gemini | groq | m3 | cmdc
TRANSLATION_PROVIDER=gemini

# --- gemini (default) ---
# Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
TRANSLATION_MODEL=gemini-2.0-flash-exp

# --- groq ---
# GROQ_API_KEY=your_groq_api_key_here

# --- m3 (Anthropic-Messages-compatible endpoint) ---
# M3_API_BASE=https://your-proxy.example.com
# M3_API_KEY=your_proxy_key_here
# M3_MODEL=your-model-id

# --- cmdc (Command Code CLI, headless) ---
# Requires the `cmdc` CLI installed and signed in on the host running the
# server — it carries its own auth, so no API key is needed here.
# CMDC_BIN=cmdc
# Model used for translation. Empty = the CLI's configured default.
# List options with `cmdc --list-models`; only models included in your
# plan are usable.
# CMDC_MODEL=qwen/qwen3.8-flash
# CMDC_TIMEOUT_MS=300000

# Vercel KV (auto-populated when Vercel KV is provisioned)
KV_URL=redis://...
KV_REST_API_URL=https://...
KV_REST_API_TOKEN=...
KV_REST_API_READ_ONLY_TOKEN=...

# Optional
TRANSLATION_MODEL=gemini-2.0-flash-exp
CACHE_TTL_SECONDS=2592000
